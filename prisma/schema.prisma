generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// USERS & AUTH
//////////////////////////

model users {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name     String?
  email         String? @unique
  phone         String? @unique
  password_hash String?
  platform_role String  @default("artist") // artist | admin
  profile_img   String?
  contact_info  Json? // { instagram?, whatsapp?, bio? }
  verified      Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  // relations
  bookings          bookings[]
  studios_owned     studios[]           @relation("studio_owner")
  studio_members    studio_members[]
  practice_sessions practice_sessions[]
  notifications     notifications[]
  audit_logs        audit_logs[]        @relation("actor_logs")
}

//////////////////////////
// STUDIOS
//////////////////////////

model studios {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id    String   @db.Uuid
  name        String
  description String?
  location    String?
  timezone    String   @default("Africa/Nairobi")
  amenities   String[]
  verified    Boolean  @default(false)

  // payment settings
  tizii_paybill   String?
  studio_paybill  String?
  till_number     String?
  payment_type    String  @default("tizii_paybill")
  payout_schedule String  @default("monthly")
  payout_account  Json?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  // relations
  owner                   users                     @relation("studio_owner", fields: [owner_id], references: [id], onDelete: Cascade)
  rooms                   rooms[]
  bookings                bookings[]
  availability            studio_availability[]
  availability_exceptions availability_exceptions[]
  gallery                 studio_photos[]
  staff                   studio_members[]
  practice_sessions       practice_sessions[]
  payouts                 payouts[]
  statements              statements[]
  notifications           notifications[]
}

//////////////////////////
// ROOMS
//////////////////////////

model rooms {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id      String   @db.Uuid
  name           String
  description    String?
  type           String?
  hourly_rate    Decimal  @db.Decimal(10, 2)
  overnight_rate Decimal? @db.Decimal(10, 2)
  visible        Boolean  @default(true)
  equipment      String[]
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt

  // relations
  studio                       studios                        @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  availability                 room_availability[]
  availability_exceptions      room_availability_exceptions[]
  photos                       room_photos[]
  bookings                     bookings[]
  availability_exceptions_back availability_exceptions[]      @relation("room_exception_back")

  @@index([studio_id])
}

//////////////////////////
// AVAILABILITY & EXCEPTIONS
//////////////////////////

model studio_availability {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id   String @db.Uuid
  day_of_week Int
  open_time   String
  close_time  String

  studio studios @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, day_of_week])
}

model room_availability {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id     String @db.Uuid
  day_of_week Int
  open_time   String
  close_time  String

  room rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, day_of_week])
}

model availability_exceptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id  String?  @db.Uuid
  room_id    String?  @db.Uuid
  date       DateTime
  start_time String?
  end_time   String?
  reason     String?

  studio studios? @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  room   rooms?   @relation("room_exception_back", fields: [room_id], references: [id], onDelete: Cascade)

  @@index([studio_id, room_id, date])
}

model room_availability_exceptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id    String   @db.Uuid
  date       DateTime
  start_time String?
  end_time   String?
  reason     String?

  room rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, date])
}

//////////////////////////
// BOOKINGS & SLOTS
//////////////////////////

model bookings {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artist_id        String   @db.Uuid
  studio_id        String   @db.Uuid
  room_id          String?  @db.Uuid
  start_time       DateTime @db.Timestamptz(6)
  end_time         DateTime @db.Timestamptz(6)
  duration_minutes Int
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("KES")
  status           String   @default("pending")
  notes            String?
  collaborators    Json?
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt

  artist            users               @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  studio            studios             @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  room              rooms?              @relation(fields: [room_id], references: [id], onDelete: Cascade)
  slots             booking_slots[]
  payments          payments[]
  practice_sessions practice_sessions[]

  @@index([studio_id, start_time, status])
  @@index([room_id, start_time, status])
  @@index([artist_id, start_time])
}

model booking_slots {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id String   @db.Uuid
  start_time DateTime @db.Timestamptz(6)
  end_time   DateTime @db.Timestamptz(6)

  booking bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
}

//////////////////////////
// PAYMENTS, PAYOUTS & STATEMENTS
//////////////////////////

model payments {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id                String?  @db.Uuid
  provider                  String
  provider_reference        String?
  amount                    Decimal? @db.Decimal(10, 2)
  currency                  String?  @default("KES")
  status                    String?  @default("pending")
  phone_number              String?
  mpesa_merchant_request_id String?
  mpesa_checkout_request_id String?
  mpesa_result_code         Int?
  mpesa_result_desc         String?
  mpesa_account_reference   String?
  mpesa_paybill_number      String?
  mpesa_till_number         String?
  raw_response              Json?
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt

  booking bookings? @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
  @@index([provider_reference])
}

model payouts {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id    String   @db.Uuid
  period_from  DateTime
  period_to    DateTime
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("KES")
  method       String
  provider_ref String?
  status       String   @default("pending")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt

  studio studios @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, period_from, period_to])
}

model statements {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id    String   @db.Uuid
  period_from  DateTime
  period_to    DateTime
  generated_at DateTime @default(now())
  summary      Json
  file_url     String?
  format       String   @default("pdf")

  studio studios @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id, period_from, period_to])
}

//////////////////////////
// STUDIO & ROOM PHOTOS
//////////////////////////

model studio_photos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id  String   @db.Uuid
  url        String
  alt_text   String?
  created_at DateTime @default(now())

  studio studios @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([studio_id])
}

model room_photos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id    String   @db.Uuid
  url        String
  alt_text   String?
  created_at DateTime @default(now())

  room rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id])
}

//////////////////////////
// STUDIO MEMBERS (ROLE PER STUDIO)
//////////////////////////

model studio_members {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studio_id  String   @db.Uuid
  user_id    String   @db.Uuid
  role       String
  invited_by String?  @db.Uuid
  created_at DateTime @default(now())

  studio studios @relation(fields: [studio_id], references: [id], onDelete: Cascade)
  user   users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([studio_id, user_id])
  @@index([user_id])
}

//////////////////////////
// NOTIFICATIONS & AUDIT
//////////////////////////

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  studio_id  String?  @db.Uuid
  type       String
  payload    Json
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user   users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  studio studios? @relation(fields: [studio_id], references: [id], onDelete: Cascade)

  @@index([user_id, studio_id, type])
}

model audit_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String?  @db.Uuid
  action     String
  target     Json?
  meta       Json?
  created_at DateTime @default(now())

  actor users? @relation("actor_logs", fields: [actor_id], references: [id])

  @@index([actor_id, action])
}

//////////////////////////
// PRACTICE SESSIONS
//////////////////////////

model practice_sessions {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id       String?  @db.Uuid
  artist_id        String?  @db.Uuid
  studio_id        String?  @db.Uuid
  recorded_minutes Int?
  exercises        Json?
  created_at       DateTime @default(now())

  user    users?    @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  booking bookings? @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  studio  studios?  @relation(fields: [studio_id], references: [id], onDelete: Cascade)
}
